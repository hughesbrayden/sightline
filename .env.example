# Copy this file to .env and fill in at least one key. Never commit .env.

# OpenRouter key (openrouter.ai/keys) - routes to Jev as typesafe/jev-1.13
OPENROUTER_API_KEY=

# Optional: direct TypeSafe key (console.typesafe.ai, early access)
TYPESAFE_API_KEY=

# MongoDB: local container -> `docker compose up -d && python puzzle_draft/mongo_setup.py setup` fills these in .env
MONGODB_URI_ADMIN=
MONGODB_URI_CURATOR=
MONGODB_URI_SCORER=
MONGODB_URI_DASHBOARD=

# Curator LLM via OpenRouter (same key as Jev). Open model to stay inside the $10 credit.
CURATOR_MODEL=z-ai/glm-5.2

# LangSmith free Developer plan (no card): 5k traces/month, 14-day retention
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=jevly
